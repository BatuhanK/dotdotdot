{
  "name": "dotdotdot",
  "private": true,
  "version": "0.1.0",
  "description": "Write a chat, get a video that looks like a real iMessage or WhatsApp screen recording. Rendered in the browser.",
  "license": "MIT",
  "homepage": "https://dotdotdot.batuhan.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BatuhanK/dotdotdot.git"
  },
  "bugs": {
    "url": "https://github.com/BatuhanK/dotdotdot/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "cf-typegen": "wrangler types worker/worker-configuration.d.ts",
    "deploy": "CLOUDFLARE_ENV=production pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "hono": "^4.13.13",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.53.0",
    "mediabunny": "^1.61.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
